{
  "manifest_version": 3,
  "name": "Web to Figma",
  "version": "2.0",
  "description": "웹페이지를 캡처해 피그마 레이어로 클립보드에 복사합니다. Copy any webpage to Figma as editable layers.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web to Figma",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["scripting", "activeTab", "debugger", "clipboardWrite", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
